option version = "1.0.0";

import "vnet/interface_types.api";

/** \brief Enable/disable OSVBNG punt for a protocol on an interface
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param sw_if_index - interface index
    @param protocol - protocol type (0=DHCPv4, 1=DHCPv6, 2=ARP, 3=PPPoE-Disc, 4=PPPoE-Sess, 5=IPv6-ND, 6=L2TP)
    @param enable - true to enable, false to disable
*/
autoreply define osvbng_punt_enable_disable
{
  u32 client_index;
  u32 context;
  vl_api_interface_index_t sw_if_index;
  u8 protocol;
  bool enable;
};

/** \brief Get OSVBNG punt statistics
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
*/
define osvbng_punt_stats_dump
{
  u32 client_index;
  u32 context;
};

/** \brief OSVBNG punt statistics details
    @param context - sender context, to match reply w/ request
    @param protocol - protocol type
    @param packets_punted - number of packets successfully punted
    @param packets_dropped - number of packets dropped (socket error)
    @param packets_policed - number of packets dropped by policer
    @param policer_rate - current policer rate (pps)
    @param policer_burst - current policer burst size
*/
define osvbng_punt_stats_details
{
  u32 context;
  u8 protocol;
  u64 packets_punted;
  u64 packets_dropped;
  u64 packets_policed;
  f64 policer_rate;
  u32 policer_burst;
};

/** \brief Configure OSVBNG punt policer
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param protocol - protocol type
    @param rate - packets per second (0 to disable)
    @param burst - burst size in packets
*/
autoreply define osvbng_punt_policer_configure
{
  u32 client_index;
  u32 context;
  u8 protocol;
  f64 rate;
  u32 burst;
};

/** \brief Dump OSVBNG punt registrations
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param sw_if_index - filter to one interface, or ~0 for all
*/
define osvbng_punt_registration_dump
{
  u32 client_index;
  u32 context;
  vl_api_interface_index_t sw_if_index;
};

/** \brief OSVBNG punt registration details
    @param context - sender context, to match reply w/ request
    @param sw_if_index - interface index
    @param protocol - protocol type (0=DHCPv4, 1=DHCPv6, 2=ARP, 3=PPPoE-Disc, 4=PPPoE-Sess, 5=IPv6-ND, 6=L2TP)
*/
define osvbng_punt_registration_details
{
  u32 context;
  vl_api_interface_index_t sw_if_index;
  u8 protocol;
};

/*
 * Local Variables:
 * eval: (c-set-style "gnu")
 * End:
 */
