 *
 * osvbng Tunnel Plugin API
 * Generic tunnel RX dispatch onto the device-input feature arc.
 */

option version = "1.1.0";

/** \brief Get the tunnel decap next indices for osvbng-tunnel-input
    osvbng-tunnel-input is registered as a next node of vxlan4-input and
    vxlan6-input at plugin init. Create a vxlan tunnel with the returned
    value as decap_next_index and every decapsulated frame re-enters the
    device-input feature arc for the tunnel sw_if_index, so l2gw / ipoe /
    pppoe features armed on the tunnel behave exactly as on a physical
    port; with no features armed frames continue into ethernet-input.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
*/
define osvbng_tunnel_decap_next_get
{
  u32 client_index;
  u32 context;
};

/** \brief Reply with the decap next indices
    @param context - sender context, to match reply w/ request
    @param retval - return code
    @param vxlan4_next - next index on vxlan4-input (~0 = vxlan plugin
           not loaded)
    @param vxlan6_next - next index on vxlan6-input (~0 = vxlan plugin
           not loaded)
*/
define osvbng_tunnel_decap_next_get_reply
{
  u32 context;
  i32 retval;
  u32 vxlan4_next;
  u32 vxlan6_next;
};

/** \brief Get the pseudowire decap next indices for osvbng-pw-input
    osvbng-pw-input is the decap next for transport tunnels bound to a
    pseudowire headend: decapsulated frames are re-attributed to the
    headend interface and enter ethernet-input, so VLAN subinterfaces
    on the headend classify exactly as on a physical port.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
*/
define osvbng_pw_decap_next_get
{
  u32 client_index;
  u32 context;
};

/** \brief Reply with the pseudowire decap next indices
    @param context - sender context, to match reply w/ request
    @param retval - return code
    @param vxlan4_next - next index on vxlan4-input (~0 = vxlan plugin
           not loaded)
    @param vxlan6_next - next index on vxlan6-input (~0 = vxlan plugin
           not loaded)
*/
define osvbng_pw_decap_next_get_reply
{
  u32 context;
  i32 retval;
  u32 vxlan4_next;
  u32 vxlan6_next;
};

/** \brief Bind or unbind a pseudowire headend to a transport tunnel
    Binding installs the tunnel -> headend RX mapping and replaces the
    headend's hw output node so all TX (including subinterface TX)
    rides the transport tunnel; unbinding restores the original output
    node. One headend per tunnel and one tunnel per headend.
    @param client_index - opaque cookie to identify the sender
    @param context - sender context, to match reply w/ request
    @param tunnel_sw_if_index - transport tunnel interface
    @param headend_sw_if_index - headend (loopback) interface
    @param is_bind - bind if non-zero, else unbind
*/
autoreply define osvbng_pw_bind
{
  u32 client_index;
  u32 context;
  u32 tunnel_sw_if_index;
  u32 headend_sw_if_index;
  bool is_bind;
};

